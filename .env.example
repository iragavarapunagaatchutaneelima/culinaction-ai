# CulinAction AI — copy to .env and fill in. Never commit .env.

# HTTP port for the API (and the built web app in production)
PORT=8787

# --- Database ------------------------------------------------------------
# Local/self-hosted: a SQLite file (created automatically).
DATABASE_PATH=data/culinaction.db
# Serverless (Vercel): a remote Turso / libSQL database. When TURSO_DATABASE_URL is set it is used
# instead of DATABASE_PATH. Example URL: libsql://your-db-name-your-org.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Optional AI explanation layer ---------------------------------------
# Leave blank to run without AI. The decision engine works without it and the
# UI shows "AI explanation: not configured".
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=20000

# Set to 1 when serving over HTTPS (adds the Secure flag to the session cookie)
COOKIE_SECURE=
